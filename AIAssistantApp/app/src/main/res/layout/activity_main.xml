<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@color/toolbar_bg" android:gravity="center_vertical" android:padding="3dp">
        <Button android:id="@+id/btnBrain" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="🧠" android:contentDescription="Intelligence Core"/>
        <Button android:id="@+id/btnPower" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="🚀" android:contentDescription="Supreme Power Mode"/>
        <Button android:id="@+id/btnAgent" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="⚡" android:contentDescription="Agent Mode"/>
        <Button android:id="@+id/btnThink" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="🧭" android:contentDescription="Pași"/>
        <Button android:id="@+id/btnPersona" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="🎭"/>
        <Button android:id="@+id/btnHistory" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="📚"/>
        <Button android:id="@+id/btnWorkspace" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="🧩"/>
        <Button android:id="@+id/btnWatcher" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="🛰️"/>
        <Button android:id="@+id/btnExport" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="↗"/>
        <Button android:id="@+id/btnZip" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="📦"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="4dp">
        <TextView android:id="@+id/tvWorkspace" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🧩 Global Workspace" android:textColor="@color/text_main" android:textSize="12sp"/>
        <TextView android:id="@+id/tvAttachment" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/accent2" android:textSize="11sp"/>
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnChipNew" android:layout_width="wrap_content" android:layout_height="38dp" android:text="✚ Nou"/>
        <Button android:id="@+id/btnChipNews" android:layout_width="wrap_content" android:layout_height="38dp" android:text="📰 Verifică"/>
        <Button android:id="@+id/btnChipExplain" android:layout_width="wrap_content" android:layout_height="38dp" android:text="💡 Explică"/>
        <Button android:id="@+id/btnChipCode" android:layout_width="wrap_content" android:layout_height="38dp" android:text="⌨️ Proiect"/>
        <Button android:id="@+id/btnChipSummarize" android:layout_width="wrap_content" android:layout_height="38dp" android:text="📝 Rezumă"/>
    </LinearLayout></HorizontalScrollView>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="4dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/btnAttach" android:layout_width="44dp" android:layout_height="44dp" android:text="📎"/>
        <Button android:id="@+id/btnMic" android:layout_width="44dp" android:layout_height="44dp" android:text="🎤"/>
        <EditText android:id="@+id/etMessage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Întreabă AI-ul…" android:textColor="@color/text_main" android:textColorHint="@color/text_hint" android:background="@color/bubble_ai" android:padding="12dp" android:inputType="textCapSentences|textMultiLine"/>
        <Button android:id="@+id/btnSend" android:layout_width="48dp" android:layout_height="44dp" android:text="➤"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
        <EditText android:id="@+id/etApiKey" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Cheie Gemini — stocată criptat" android:textSize="11sp" android:textColor="@color/text_main" android:textColorHint="@color/text_hint" android:background="@color/bubble_ai" android:padding="8dp"/>
        <Button android:id="@+id/btnSaveKey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔐"/>
    </LinearLayout>
</LinearLayout>
